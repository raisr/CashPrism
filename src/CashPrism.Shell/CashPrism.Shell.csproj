<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      The Blazor components live in CashPrism.Web, so this project has no .razor
      files and the Web SDK would not pull in the framework's browser assets.
      Without this the page renders but _framework/blazor.web.js is a 404 and the
      circuit never starts.
    -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>

    <!--
      The platforms a release is built for. The shape of the shipped build is
      set here, never on a publish command line, because it decides which
      packages are resolved and THIRD-PARTY-NOTICES.md is generated from exactly
      that set. The one input a command line gives is `-r` with one of these;
      without it, the publish is the portable, framework-dependent build the
      container image runs.
    -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>

    <!-- IIS is not a host CashPrism runs under. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <!--
    A platform build is what a person double-clicks without .NET installed: the
    runtime and every assembly inside one executable. The Web SDK keeps wwwroot,
    the static asset manifest and appsettings.json beside it on purpose, so a
    release is the executable together with those, not the executable alone.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- No debug symbols in a release, neither this project's nor its references'. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>.xml;.pri;.dll.config;.exe.config</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CashPrism.Application\CashPrism.Application.csproj" />
    <ProjectReference Include="..\CashPrism.Domain\CashPrism.Domain.csproj" />
    <ProjectReference Include="..\CashPrism.Infrastructure\CashPrism.Infrastructure.csproj" />
    <ProjectReference Include="..\CashPrism.Infrastructure.Finanzguru\CashPrism.Infrastructure.Finanzguru.csproj" />
    <ProjectReference Include="..\CashPrism.Web\CashPrism.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Generated by .devkit/generate-third-party-notices.cs from this project's
      own publish output; listed here only so it ships next to the executable,
      never maintained by hand.

      Nothing regenerates it as a side effect of building or publishing, and
      that is deliberate. The `notices` gate already fails while the committed
      file is stale, so a target here would be a second mechanism for the same
      problem, and it costs: a build that rewrites a tracked source file leaves
      a clean checkout dirty, it needs a property to guard against the
      generator's own inner publish re-triggering it, and it makes `dotnet
      publish` depend on the SDK's file-based `dotnet run` plus a `dotnet tool
      restore` over the network. The variant hooked to Build also fired on an IDE's
      background design-time builds and spawned the application in a loop until
      killed by hand.

      The generator publishes for every runtime identifier listed above and
      once without one, and fails when they ship different packages, so one
      notices file holds for every build. Kept out of the single-file bundle:
      a licence notice belongs where a person can read it.
    -->
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />

    <!-- Development settings are for `dotnet run`, never part of a release. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!--
    A runtime identifier outside the list would publish a build no notices
    file was generated for. Restore resolves the list anyway; this says so
    before anything is built.
  -->
  <Target Name="RejectUnlistedRuntimeIdentifier" BeforeTargets="Restore;_CheckForInvalidConfigurationAndPlatform" Condition="'$(RuntimeIdentifier)' != '' and !$([System.String]::Copy(';$(RuntimeIdentifiers);').Contains(';$(RuntimeIdentifier);'))">
    <Error Text="CashPrism is published for $(RuntimeIdentifiers) only, not for '$(RuntimeIdentifier)'. A new platform is added to RuntimeIdentifiers in CashPrism.Shell.csproj, so THIRD-PARTY-NOTICES.md is generated for it too." />
  </Target>

</Project>
