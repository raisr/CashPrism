@inject IStringLocalizer<Strings> text

@* The drawer's destinations. The list comes from NavigationItems so the label
   here and the one in the app bar can never disagree. A section heading is
   written wherever the section changes. *@
<nav class="cp-nav">
  @{ string? section = null; }
  @foreach (var item in NavigationItems.All)
  {
    if (item.SectionKey is not null && item.SectionKey != section)
    {
      <div class="cp-sidebar__section cp-label">@text[item.SectionKey]</div>
    }

    section = item.SectionKey;
    var label = text[item.TitleKey].Value;

    @* On the rail the label is hidden, so it moves into the tooltip and the
       accessible name. *@
    <NavLink href="@item.Href"
             class="cp-nav__item"
             ActiveClass="cp-nav__item--on"
             title="@(Collapsed ? label : null)"
             aria-label="@(Collapsed ? label : null)"
             Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
      <CpIcon Name="@item.Icon" />
      <span>@label</span>
      @if (Counts.TryGetValue(item, out var count))
      {
        <span class="cp-nav__count">@count</span>
      }
    </NavLink>
  }
</nav>

@code {
    /// <summary>Whether the drawer is collapsed to its icon rail.</summary>
    [Parameter]
    public bool Collapsed { get; set; }

    /// <summary>
    /// A figure to show beside a destination, already written for a person.
    /// A destination with no entry shows none.
    /// </summary>
    [Parameter]
    public IReadOnlyDictionary<NavigationItem, string> Counts { get; set; } = new Dictionary<NavigationItem, string>();
}
