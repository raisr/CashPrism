<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to the exact version: the component library decides how every
         screen looks, so an unattended minor bump is a visual change nobody
         reviewed. -->
    <PackageReference Include="MudBlazor" Version="[9.11.0]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CashPrism.Application\CashPrism.Application.csproj" />
    <ProjectReference Include="..\CashPrism.Domain\CashPrism.Domain.csproj" />
  </ItemGroup>

</Project>
