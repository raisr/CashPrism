@using CashPrism.Web.Bookings
@inject IStringLocalizer<Strings> text

@* A category's name on a pill tinted in the category's colour, led by a dot
   in the full colour. The tint and the dot are drawn by the stylesheet from
   the colour handed over as --c (see components.css). *@
<span class="cp-badge cp-badge--category" style="@ColourStyle">@text[Category.NameKey]</span>

@code {
    /// <summary>The category to name, as <see cref="CategoryStyle.For"/> returns it.</summary>
    [Parameter, EditorRequired]
    public CategoryStyle Category { get; set; } = CategoryStyle.Other;

    private string ColourStyle => $"--c:{Category.Colour}";
}
