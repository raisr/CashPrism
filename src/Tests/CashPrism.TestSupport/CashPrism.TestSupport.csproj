<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Deliberately not a test project: no Microsoft.NET.Test.Sdk, no runner, no
    tests of its own. `dotnet test` therefore skips it instead of failing on an
    assembly that contains none.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\CashPrism.Infrastructure.Finanzguru\CashPrism.Infrastructure.Finanzguru.csproj" />
  </ItemGroup>

  <!--
    The demo export the repository ships, embedded from where it is committed
    rather than copied, so every test reads the file a user downloads. See
    docs/demo-data.md.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\samples\demo-export.xlsx" LogicalName="demo-export.xlsx" Link="Samples\demo-export.xlsx" />
  </ItemGroup>

</Project>
