<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The switch CashPrism.Shell.csproj sets as BlazorDisableThrowNavigationException.
      The host runs inside this process here, with this project's runtime
      configuration, so without it the tests would redirect the way the shipped
      application does not. Spelled out as the runtime option, because only the
      Web SDK translates the property and this project uses the plain one.
    -->
    <RuntimeHostConfigurationOption Include="Microsoft.AspNetCore.Components.Endpoints.NavigationManager.DisableThrowNavigationException" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\CashPrism.Application\CashPrism.Application.csproj" />
    <ProjectReference Include="..\..\Core\CashPrism.Domain\CashPrism.Domain.csproj" />
    <ProjectReference Include="..\..\Core\CashPrism.Infrastructure\CashPrism.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Core\CashPrism.Infrastructure.Finanzguru\CashPrism.Infrastructure.Finanzguru.csproj" />
    <ProjectReference Include="..\..\Core\CashPrism.Web\CashPrism.Web.csproj" />
    <ProjectReference Include="..\..\CashPrism.Shell\CashPrism.Shell.csproj" />
    <ProjectReference Include="..\CashPrism.TestSupport\CashPrism.TestSupport.csproj" />
  </ItemGroup>

</Project>
