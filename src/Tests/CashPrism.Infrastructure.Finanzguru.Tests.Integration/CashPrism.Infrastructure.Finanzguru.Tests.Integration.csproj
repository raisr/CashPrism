<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Read from the assembly, not from disk, so the tests do not depend on the
    working directory. The logical name is the file name alone; see
    docs/finanzguru-export.md for where the file comes from.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures\*.xlsx" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CashPrism.Infrastructure.Finanzguru\CashPrism.Infrastructure.Finanzguru.csproj" />
    <ProjectReference Include="..\CashPrism.TestSupport\CashPrism.TestSupport.csproj" />
  </ItemGroup>

</Project>
