@* One figure on a card of its own, as the design's stat card draws it: a
   round icon tile, a label that names what is counted, the figure, and how
   it moved since the period before. Whether a move is good is the caller's
   to say — more income is, more spending is not. *@
<section class="cp-card">
  <div class="cp-stat">
    <IconTile Icon="@Icon" Colour="@Colour" Size="44" Round="true" />
    <div class="cp-stat__body">
      <div class="cp-stat__label">@Label</div>
      <div class="cp-stat__value">@ChildContent</div>
      @if (Delta is not null)
      {
        <div class="cp-stat__delta">
          <b class="@DeltaClass">
            <CpIcon Name="@(DeltaUp ? "arrow-up-right" : "arrow-down-right")" Size="14" />
            @Delta
          </b>
          @DeltaLabel
        </div>
      }
    </div>
  </div>
</section>

@code {
    /// <summary>The Lucide name of the glyph in the tile.</summary>
    [Parameter, EditorRequired]
    public string Icon { get; set; } = string.Empty;

    /// <summary>A CSS colour for the tile, usually one of the design system's custom properties.</summary>
    [Parameter, EditorRequired]
    public string Colour { get; set; } = string.Empty;

    /// <summary>What the figure counts, already localised.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>The figure.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>How the figure moved, already formatted, or nothing when there is nothing to compare with.</summary>
    [Parameter]
    public string? Delta { get; set; }

    /// <summary>Whether the figure went up, which decides the arrow.</summary>
    [Parameter]
    public bool DeltaUp { get; set; }

    /// <summary>Whether the move is a good one, which decides the colour.</summary>
    [Parameter]
    public bool DeltaGood { get; set; }

    /// <summary>What the move is measured against, already localised.</summary>
    [Parameter]
    public string? DeltaLabel { get; set; }

    private string DeltaClass => DeltaGood ? "cp-delta--good" : "cp-delta--bad";
}
