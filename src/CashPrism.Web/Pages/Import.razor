@page "/import"
@using CashPrism.Application.Imports
@using CashPrism.Application.Paging
@using CashPrism.Domain.Imports
@using CashPrism.Web.Imports
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IStringLocalizer<Strings> text
@inject Importer importer
@inject ImportActivity activity
@inject IImportRunReader runReader
@inject ILogger<Import> log

<PageFrame Title="@text["NavImport"]" Lead="@text["ImportLead"]">
  <div class="cp-import-grid">
    <div class="@(activity.IsRunning ? "cp-card cp-import-grid__wide cp-import-busy" : "cp-card cp-import-grid__wide")">
      <div class="cp-card__body">
        @* The file input lies invisibly over the whole zone, so a click
           anywhere opens the file picker and a file dropped anywhere lands in
           it — the browser's own drag and drop, no script of ours.

           It stays in the page while an import runs, disabled, and only what
           the zone shows changes: the upload is read from this very element
           after the import has started, and an input taken out of the page
           leaves the read waiting for ever.

           The size limit is checked in OnFilePickedAsync, so it can be named
           in German. *@
        <div class="@DropzoneClass">
          <InputFile class="cp-dropzone__input"
                     accept=".xlsx"
                     disabled="@activity.IsRunning"
                     aria-label="@text["ImportDropTitle"]"
                     OnChange="OnFilePickedAsync"
                     @ondragenter="() => dragging = true"
                     @ondragleave="() => dragging = false"
                     @ondrop="() => dragging = false" />
          @if (activity.IsRunning)
          {
            <span class="cp-spinner cp-spinner--lg" role="progressbar"></span>
            <div class="cp-h3">@text["ImportRunning"]</div>
            <div class="cp-dropzone__hint">@text["ImportRunningHint"]</div>
          }
          else
          {
            <span class="cp-empty__icon"><CpIcon Name="file-spreadsheet" /></span>
            <div class="cp-h3">@text["ImportDropTitle"]</div>
            <div class="cp-dropzone__hint">@text["ImportDropHint"]</div>
          }
        </div>

        @if (!activity.IsRunning && activity.Result is { } message)
        {
          <div class="cp-import-result">
            <Alert Tone="ToneOf(message.Severity)" Title="@message.Headline" Details="message.Details" />
          </div>
        }
      </div>
    </div>

    <div class="cp-card">
      <div class="cp-card__head">
        <div class="cp-card__title cp-h3">@text["ImportStepsTitle"]</div>
      </div>
      <ol class="cp-card__body cp-steps">
        @foreach (var (icon, title, hint) in Steps)
        {
          <li class="cp-steps__item">
            <IconTile Icon="@icon" Colour="var(--cp-primary)" Round="true" />
            <div>
              <div class="cp-steps__title">@text[title]</div>
              <div class="cp-steps__hint">@text[hint]</div>
            </div>
          </li>
        }
      </ol>
    </div>
  </div>

  @* What came in before. Left out until something did: before the first
     import the zone above is the only thing worth looking at. *@
  @if (runs is { TotalCount: > 0 })
  {
    <div class="cp-card cp-card--flush cp-import-history">
      <div class="cp-card__head">
        <div class="cp-card__title">
          <div class="cp-h3">@text["ImportHistoryTitle"]</div>
          <div class="cp-card__sub">@text["ImportHistoryLead"]</div>
        </div>
      </div>
      @* A history has one order — newest first — so nothing here sorts. *@
      <div class="cp-table-wrap">
        <table class="cp-table">
          <thead>
            <tr>
              <th>@text["ImportHistoryColumnFile"]</th>
              <th>@text["ImportHistoryColumnImportedAt"]</th>
              <th class="cp-cell-end">@text["ImportHistoryColumnInserted"]</th>
              <th class="cp-cell-end">@text["ImportHistoryColumnUpdated"]</th>
              <th class="cp-cell-end">@text["ImportHistoryColumnRowsRead"]</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var run in runs.Items)
            {
              <tr>
                <td>
                  <div class="cp-party">
                    <IconTile Icon="file-spreadsheet" Colour="var(--cp-prism-green)" Size="34" />
                    <div class="cp-party__text">
                      @* The checksum identifies the file beyond its name, which is
                         whatever it was saved as; it is kept for whoever needs
                         to match a run against a file, on hover. *@
                      <div class="cp-party__name cp-import-history__file" title="@run.FileHash">@run.FileName</div>
                      <div class="cp-party__reference">@ExportedOn(run)</div>
                    </div>
                  </div>
                </td>
                <td class="cp-muted-strong cp-figure">@ImportRunFormat.ImportedAt(run.ImportedAt)</td>
                @* Only new bookings are good news; a run that brought none shows
                   a plain zero rather than a green "+0". *@
                <td class="cp-cell-end">
                  @if (run.BookingsInserted > 0)
                  {
                    <span class="cp-badge cp-badge--success">+@ImportRunFormat.Count(run.BookingsInserted)</span>
                  }
                  else
                  {
                    <span class="cp-figure cp-muted-strong">@ImportRunFormat.Count(0)</span>
                  }
                </td>
                <td class="cp-cell-end cp-figure cp-import-history__count">@ImportRunFormat.Count(run.BookingsUpdated)</td>
                <td class="cp-cell-end cp-figure cp-muted-strong">@ImportRunFormat.Count(run.RowsRead)</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
      <Pager Page="runsPage"
             PageSize="runsPageSize"
             Total="runs.TotalCount"
             InfoFormat="@text["ImportHistoryPagerInfo"]"
             PageChanged="GoToRunsPageAsync"
             PageSizeChanged="ChangeRunsPageSizeAsync" />
    </div>
  }
</PageFrame>

@* Over the whole page rather than only the zone: an import is not something
   to work around while it runs, and a lock on the zone alone would leave the
   navigation clickable — which is how a second import used to get started on
   top of the first. The card with the zone is lifted above it (cp-import-busy),
   so what is happening stays in full light while the rest of the page dims;
   dimmed with everything else, the spinner was easy to miss. The zone's input
   is disabled meanwhile, so the lifted card takes no second file. *@
<MudOverlay Visible="@activity.IsRunning" DarkBackground="true" ZIndex="9999" />

@code {
    private static readonly (string Icon, string Title, string Hint)[] Steps =
    [
        ("smartphone", "ImportStep1Title", "ImportStep1Hint"),
        ("file-spreadsheet", "ImportStep2Title", "ImportStep2Hint"),
        ("upload", "ImportStep3Title", "ImportStep3Hint"),
    ];

    private bool dragging;

    private string DropzoneClass => activity.IsRunning
        ? "cp-dropzone cp-dropzone--busy"
        : dragging ? "cp-dropzone cp-dropzone--over" : "cp-dropzone";

    private Page<ImportRun>? runs;
    private int runsPage;
    private int runsPageSize = 25;

    protected override async Task OnInitializedAsync()
    {
        activity.Changed += OnActivityChanged;

        // The import writes through the circuit's database context, which
        // takes one query at a time. Coming back to the page while one runs,
        // the history waits for it to finish.
        if (!activity.IsRunning)
        {
            await LoadRunsAsync();
        }
    }

    /// <inheritdoc />
    public void Dispose() => activity.Changed -= OnActivityChanged;

    /// <summary>
    /// The import raises this from the thread it ran on, so the render — and
    /// the history read once it has finished — is marshalled back onto the
    /// circuit's.
    /// </summary>
    private void OnActivityChanged() => _ = InvokeAsync(RefreshAsync);

    private async Task RefreshAsync()
    {
        try
        {
            if (!activity.IsRunning)
            {
                await LoadRunsAsync();
            }

            StateHasChanged();
        }
        catch (Exception exception)
        {
            // Nobody awaits this, so a failure would otherwise vanish. Handed to
            // the renderer, it ends the circuit the way a failed render does.
            await DispatchExceptionAsync(exception);
        }
    }

    private async Task LoadRunsAsync()
        => runs = await runReader.ReadPageAsync(new PageRequest(runsPage * runsPageSize, runsPageSize));

    private Task GoToRunsPageAsync(int page)
    {
        runsPage = page;

        return LoadRunsAsync();
    }

    private Task ChangeRunsPageSizeAsync(int size)
    {
        runsPageSize = size;
        runsPage = 0;

        return LoadRunsAsync();
    }

    private string ExportedOn(ImportRun run)
        => ImportRunFormat.ExportedOn(run.ExportedOn) is { } day
            ? text["ImportHistoryExportedOn", day]
            : text["ImportHistoryExportedOnUnknown"];

    private async Task OnFilePickedAsync(InputFileChangeEventArgs change)
    {
        dragging = false;
        var file = change.File;

        if (file.Size > ImportFeedback.MaxUploadBytes)
        {
            activity.Report(ImportFeedback.TooLarge(file.Size, text));

            return;
        }

        // RunAsync refuses while one is in flight. The zone is replaced by the
        // spinner then, so this is the case it cannot cover: a file picked in a
        // second browser tab on the same circuit.
        await activity.RunAsync(() => ImportAsync(file));
    }

    private async Task<ImportFeedbackMessage> ImportAsync(IBrowserFile file)
    {
        using var buffer = new MemoryStream();

        try
        {
            await using var upload = file.OpenReadStream(ImportFeedback.MaxUploadBytes);

            // Buffered rather than handed on: the import hashes the file before
            // reading it as a spreadsheet, and the stream a browser upload
            // arrives on cannot rewind.
            await upload.CopyToAsync(buffer);
        }
        catch (IOException exception)
        {
            // The connection dropped mid-upload, or the browser sent more than
            // it announced. Neither is something the person can act on beyond
            // trying again, so it is one line rather than a stack trace.
            log.LogWarning(exception, "Reading the uploaded file failed");

            return ImportFeedback.Unreadable(text);
        }

        buffer.Position = 0;

        // Task.Run, deliberately, and not the pattern AGENTS.dotnet.md rules
        // out: this is not synchronous work dressed up as asynchronous. Reading
        // a workbook is CPU-bound and ClosedXML offers nothing asynchronous, so
        // on Blazor Server it would occupy the circuit's thread for the whole
        // import — about 1.4 s for the measured export (issue #23) — and the
        // page would take no input at all while the spinner turned.
        var result = await Task.Run(() => importer.ImportAsync(buffer, file.Name));

        if (result.Outcome is ImportOutcome.Failed)
        {
            // Every reason, untranslated: the page shows only the first
            // ImportFeedback.MaxShownErrors, in German, and a bug report should
            // not depend on what the browser happened to show.
            log.LogWarning(
                "Import of {FileName} was refused: {Reasons}",
                file.Name,
                string.Join(" || ", result.Errors));
        }

        return ImportFeedback.Describe(result, text);
    }

    private static AlertTone ToneOf(ImportFeedbackSeverity severity) => severity switch
    {
        ImportFeedbackSeverity.Success => AlertTone.Success,
        ImportFeedbackSeverity.Info => AlertTone.Info,
        _ => AlertTone.Danger,
    };
}
