@page "/bookings"
@using CashPrism.Application.Bookings
@using CashPrism.Application.Paging
@using CashPrism.Application.Time
@using CashPrism.Domain.Bookings
@using CashPrism.Web.Bookings
@inject IStringLocalizer<Strings> text
@inject IBookingReader reader
@inject IClock clock

<PageFrame Title="@text["NavBookings"]" Lead="@text["BookingsLead"]">
  @if (page is null)
  {
    @* Only between the first render and the first answer from the database. *@
  }
  else if (page.TotalCount == 0)
  {
    @* An empty table with a pager reading "0–0 von 0" says nothing a person can
       act on. While nothing is stored the page says so and points at the one
       screen that changes it. *@
    <EmptyState Icon="upload" Title="@text["BookingsEmpty"]" Text="@text["BookingsEmptyHint"]">
      <Actions>
        <MudButton Href="/import" Variant="Variant.Filled" Color="Color.Primary" Class="cp-btn">
          <CpIcon Name="upload" />
          @text["NavImport"]
        </MudButton>
      </Actions>
    </EmptyState>
  }
  else
  {
    @* A table of our own rather than MudDataGrid: the design groups a page's
       rows under a header per day and numbers the pages, and the grid offers
       neither without being argued with. Sorting and paging still happen in
       the database — every click asks the reader for one page. *@
    <div class="cp-card cp-card--flush">
      <div class="cp-table-wrap">
        <table class="cp-table cp-table--hover">
          <thead>
            <tr>
              <th aria-sort="@AriaSort(BookingSortColumn.Counterparty)">@SortButton(BookingSortColumn.Counterparty, text["BookingsColumnCounterparty"])</th>
              <th>@text["BookingsColumnCategory"]</th>
              <th>@text["BookingsColumnAccount"]</th>
              <th aria-sort="@AriaSort(BookingSortColumn.BookedOn)">@SortButton(BookingSortColumn.BookedOn, text["BookingsColumnDate"])</th>
              <th class="cp-cell-end" aria-sort="@AriaSort(BookingSortColumn.AmountInCents)">@SortButton(BookingSortColumn.AmountInCents, text["BookingsColumnAmount"])</th>
            </tr>
          </thead>
          <tbody>
            @{ string? day = null; }
            @foreach (var booking in page.Items)
            {
              var category = CategoryStyle.For(booking.Category, booking.SubCategory, booking.IsTransfer);

              @* Only in the order the day headers describe: sorted by name or
                 amount, the same day turns up all over the page. *@
              if (sortBy is null)
              {
                var header = DayHeaderOf(booking);
                if (header != day)
                {
                  day = header;
                  <tr class="cp-table__group"><td colspan="5">@header</td></tr>
                }
              }

              @* A row opens the booking's sheet. It takes the focus by Tab and
                 opens on Enter as well, so the sheet is not a
                 mouse-only feature. *@
              <tr class="cp-table__row" tabindex="0"
                  aria-label="@booking.Counterparty"
                  @ref="rows[booking.Fingerprint]"
                  @onclick="() => Open(booking)"
                  @onkeydown="key => OnRowKeyDown(key, booking)">
                <td>
                  <div class="cp-party">
                    <CategoryIcon Category="category" />
                    <div class="cp-party__text">
                      <div class="cp-party__name">@booking.Counterparty</div>
                      @* A bank fills this with whatever it likes, so it is
                         clamped and the whole text stays available on hover. *@
                      <div class="cp-party__reference" title="@booking.PaymentReference">@booking.PaymentReference</div>
                    </div>
                  </div>
                </td>
                <td><CategoryBadge Category="category" /></td>
                <td class="cp-muted-strong">@booking.AccountName</td>
                <td class="cp-muted-strong cp-figure">@BookingFormat.Date(booking.BookedOn)</td>
                <td class="cp-cell-end"><Amount AmountInCents="booking.AmountInCents" Currency="@booking.Currency" /></td>
              </tr>
            }
          </tbody>
        </table>
      </div>
      <Pager Page="pageIndex"
             PageSize="pageSize"
             Total="page.TotalCount"
             InfoFormat="@text["BookingsPagerInfo"]"
             PageChanged="GoToPageAsync"
             PageSizeChanged="ChangePageSizeAsync" />
    </div>
  }
</PageFrame>

<BookingSheet Booking="selected" OnClose="Close" />

@code {
    private Page<Booking>? page;

    // The rows of the page on screen, so the focus can go back to the one
    // whose sheet was just closed.
    private readonly Dictionary<string, ElementReference> rows = [];

    private Booking? selected;
    private string? returnFocusTo;

    private int pageIndex;
    private int pageSize = 25;

    // Null is the order the list opens in: newest first, grouped by day.
    private BookingSortColumn? sortBy;
    private bool descending = true;

    // Today in the local time of the machine that hosts CashPrism, which is
    // what "Heute" means to the person in front of it.
    private DateOnly Today => DateOnly.FromDateTime(clock.UtcNow.LocalDateTime);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var request = new BookingPageRequest(
            Skip: pageIndex * pageSize,
            Take: pageSize,
            SortBy: sortBy ?? BookingSortColumn.BookedOn,
            Descending: sortBy is null || descending);

        page = await reader.ReadPageAsync(request);

        // A new page renders new rows; references to the old ones are stale.
        rows.Clear();
    }

    private Task GoToPageAsync(int target)
    {
        pageIndex = target;

        return LoadAsync();
    }

    private Task ChangePageSizeAsync(int size)
    {
        pageSize = size;
        pageIndex = 0;

        return LoadAsync();
    }

    /// <summary>
    /// A click on a column sorts by it, newest or largest first; a second
    /// click turns the order round, and a third gives the list back its day
    /// headers. The design stops at the second, which would leave the grouped
    /// list unreachable once a header was clicked.
    /// </summary>
    private Task SortAsync(BookingSortColumn column)
    {
        if (sortBy != column)
        {
            sortBy = column;
            descending = true;
        }
        else if (descending)
        {
            descending = false;
        }
        else
        {
            sortBy = null;
        }

        pageIndex = 0;

        return LoadAsync();
    }

    private void Open(Booking booking) => selected = booking;

    private void OnRowKeyDown(KeyboardEventArgs key, Booking booking)
    {
        if (key.Key == "Enter")
        {
            Open(booking);
        }
    }

    // The focus goes back to the row the sheet was opened from, so a keyboard
    // user carries on in the list where they left it. It is moved after the
    // render that removes the sheet, not before it.
    private void Close()
    {
        returnFocusTo = selected?.Fingerprint;
        selected = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (returnFocusTo is { } fingerprint)
        {
            returnFocusTo = null;

            if (rows.TryGetValue(fingerprint, out var row))
            {
                await row.FocusAsync();
            }
        }
    }

    private string DayHeaderOf(Booking booking)
        => BookingFormat.DayHeader(booking.BookedOn, Today, text["BookingsToday"], text["BookingsYesterday"]);

    // On the header cell, where a screen reader looks for it.
    private string? AriaSort(BookingSortColumn column)
        => sortBy != column ? null : descending ? "descending" : "ascending";

    private RenderFragment SortButton(BookingSortColumn column, string title)
    {
        var on = sortBy == column;
        var glyph = on && !descending ? "arrow-up" : "arrow-down";

        return @<button type="button"
                        class="@(on ? "cp-sort cp-sort--on" : "cp-sort")"
                        @onclick="() => SortAsync(column)">
                  @title<CpIcon Name="@glyph" />
                </button>;
    }
}
