@page "/settings/password"
@using CashPrism.Application.Access
@using CashPrism.Domain.Access
@using CashPrism.Web.Access
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@*  Static like the login page, because a change ends in signing this device
    out, and only an HTTP response can drop a cookie — see App.razor. It needs
    a login like every other page. *@
@attribute [ExcludeFromInteractiveRouting]
@layout AccessLayout
@inject IStringLocalizer<Strings> text
@inject PasswordChange change
@inject NavigationManager navigation

<PageTitle>CashPrism — @text["ChangePasswordTitle"]</PageTitle>

<div class="cp-access__form">
  <div class="cp-access__head">
    <h1 class="cp-h2">@text["ChangePasswordTitle"]</h1>
    <p class="cp-access__lead">@text["ChangePasswordLead"]</p>
  </div>

  @if (failure is not null)
  {
    <Alert Tone="AlertTone.Danger" Title="@failure" />
  }

  <EditForm Model="Input" FormName="change-password" OnSubmit="ChangeAsync" method="post" class="cp-access__fields">
    <label class="cp-field">
      <span class="cp-field__label">@text["ChangePasswordCurrent"]</span>
      <span class="cp-input">
        <InputText type="password" @bind-Value="Input.Current" autocomplete="current-password" autofocus required />
      </span>
    </label>
    <label class="cp-field">
      <span class="cp-field__label">@text["SetupPassword"]</span>
      <span class="cp-input">
        <InputText type="password" @bind-Value="Input.Password" autocomplete="new-password" required />
      </span>
      <span class="cp-field__hint">@text["SetupPasswordHint", PasswordRule.MinimumLength]</span>
    </label>
    <label class="cp-field">
      <span class="cp-field__label">@text["SetupRepeat"]</span>
      <span class="cp-input">
        <InputText type="password" @bind-Value="Input.Repeat" autocomplete="new-password" required />
      </span>
    </label>
    <button type="submit" class="cp-btn cp-btn--primary cp-btn--block">
      <CpIcon Name="key-round" />
      @text["ChangePasswordSubmit"]
    </button>
    <a href="settings" class="cp-btn cp-btn--secondary cp-btn--block">@text["ChangePasswordBack"]</a>
  </EditForm>
</div>

@code {
    private string? failure;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "change-password")]
    private ChangeInput Input { get; set; } = default!;

    // Filled from the form on a post; a plain visit starts with an empty one.
    protected override void OnInitialized() => Input ??= new();

    private async Task ChangeAsync()
    {
        // Asked here and not by the use case, for the reason given on the
        // setup page.
        if (Input.Password != Input.Repeat)
        {
            failure = text["SetupMismatch"];

            return;
        }

        var result = await change.ChangeAsync(Input.Current, Input.Password, HttpContext.RequestAborted);

        switch (result.Outcome)
        {
            case PasswordChangeOutcome.Done:
                // Every login issued before the change no longer counts, this
                // one included; dropping the cookie says so now rather than on
                // the next request.
                await HttpContext.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
                navigation.NavigateTo(AccessPaths.LoginAfterChange);
                break;
            case PasswordChangeOutcome.Rejected or PasswordChangeOutcome.LockedOut:
                // A lockout always says until when; so does the wrong password
                // that started one.
                failure = result.LockedUntil is { } lockedUntil
                    ? text["ChangePasswordLockedOut", lockedUntil.ToLocalTime().ToString("T", CultureInfo.CurrentCulture)]
                    : text["ChangePasswordRejected"];
                break;
            case PasswordChangeOutcome.TooShort:
                failure = text["SetupTooShort", PasswordRule.MinimumLength];
                break;
        }
    }

    private sealed record ChangeInput
    {
        public string Current { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;

        public string Repeat { get; set; } = string.Empty;
    }
}
