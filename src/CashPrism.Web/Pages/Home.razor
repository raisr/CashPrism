@page "/"
@inject IStringLocalizer<Strings> text

@* "CashPrism" is a product name, not a translatable string, so it stays a
   literal here and in the layout. Everything a reader could translate comes
   from Strings.resx. *@
<PageTitle>CashPrism</PageTitle>

<h1>CashPrism</h1>

<p>
  @text["RenderModeLabel"]: <span class="badge">@renderState</span>
</p>

@code {
    // Server-rendered the badge reads the prerendered wording; once the SignalR
    // circuit is up the first interactive render flips it. That is the visible
    // proof that the wiring works end to end.
    private string? renderState;

    protected override void OnInitialized()
        => renderState = text["RenderModePrerendered"];

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        renderState = text["RenderModeInteractive"];
        StateHasChanged();
    }
}
