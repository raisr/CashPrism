@page "/"
@inject IStringLocalizer<Strings> text

<PageFrame Title="@text["NavOverview"]" Lead="@text["OverviewLead"]">
  <MudPaper Elevation="0" Outlined="true" Class="pa-6">
    <MudText Typo="Typo.body1">@text["OverviewEmpty"]</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">@text["OverviewEmptyHint"]</MudText>
  </MudPaper>

  @* Server-rendered the badge reads the prerendered wording; once the SignalR
     circuit is up the first interactive render flips it. That is the visible
     proof that the wiring works end to end. *@
  <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-4">
    @text["RenderModeLabel"]: @renderState
  </MudText>
</PageFrame>

@code {
    private string? renderState;

    protected override void OnInitialized()
        => renderState = text["RenderModePrerendered"];

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        renderState = text["RenderModeInteractive"];
        StateHasChanged();
    }
}
