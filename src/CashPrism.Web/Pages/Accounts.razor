@page "/accounts"
@using System.Net
@using CashPrism.Application.Accounts
@using CashPrism.Application.Bookings
@using CashPrism.Application.Paging
@using CashPrism.Domain.Accounts
@using CashPrism.Domain.Bookings
@using CashPrism.Web.Accounts
@using CashPrism.Web.Bookings
@using CashPrism.Web.Overview
@inject IStringLocalizer<Strings> text
@inject AccountOverviewReader accounts
@inject AccountGroupEditor groupEditor
@inject IBookingReader bookingReader
@inject AccountFlowReader flowReader
@inject AccountBalanceHistoryReader historyReader

@if (overview is null)
{
  <PageFrame Title="@text["NavAccounts"]">
    @if (loaded)
    {
      @* Also what a database imported into before balances were taken at
         import shows: the balances come with the next export, not before. *@
      <section class="cp-card">
        <EmptyState Icon="wallet" Title="@text["AccountsEmpty"]" Text="@text["AccountsEmptyHint"]">
          <Actions>
            <MudButton Href="/import" Variant="Variant.Filled" Color="Color.Primary" Class="cp-btn">
              <CpIcon Name="upload" />
              @text["NavImport"]
            </MudButton>
          </Actions>
        </EmptyState>
      </section>
    }
  </PageFrame>
}
else
{
  <PageFrame Title="@text["NavAccounts"]">
    <LeadContent>@Lead(overview)</LeadContent>
    <Actions>
      <MudSwitch T="bool"
                 @bind-Value="editing"
                 Label="@text["AccountGroupsEdit"]"
                 Color="Color.Primary"
                 Class="cp-accounts__edit" />
    </Actions>
    <ChildContent>
      <div class="cp-accounts">
        <nav class="cp-accounts__list" aria-label="@text["AccountsYours"]">
          @if (editing)
          {
            <AccountGroupEdit Groups="groups" Revision="revision" OnChange="ChangeAsync" />
          }
          else
          {
            @foreach (var group in groups)
            {
              <section class="cp-account-group" @key="group.Id">
                <div class="cp-account-group__head">
                  <span class="cp-label">@group.Name</span>
                  <span class="cp-account-group__sum"><Sum AmountInCents="group.SumInCents" /></span>
                </div>
                @* Links rather than buttons: the selection is part of the address,
                   so it survives a reload and can be bookmarked. *@
                @foreach (var account in group.Accounts)
                {
                  @* The groups come from a read of their own, so the selection is
                     matched by account rather than by instance. *@
                  var on = string.Equals(account.AccountReference, selected?.AccountReference, StringComparison.Ordinal);
                  <a class="@(on ? "cp-account-card cp-account-card--on" : "cp-account-card")"
                     href="@LinkTo(account)"
                     aria-current="@(on ? "page" : null)">
                    <span class="cp-account-card__head">
                      <IconTile Icon="wallet" Colour="var(--cp-primary)" Size="38" />
                      <span class="cp-account-card__text">
                        <span class="cp-account-card__name">@account.AccountName</span>
                        <span class="cp-account-card__number">@IbanMask.Mask(account.AccountReference)</span>
                      </span>
                      @if (Trend(account) is { } trend)
                      {
                        <Sparkline Values="trend" Colour="@(on ? "currentColor" : "var(--cp-primary)")" Area="false" Width="56" Height="24" />
                      }
                    </span>
                    <span class="cp-account-card__balance"><Sum AmountInCents="account.BalanceInCents" /></span>
                  </a>
                }
                @if (group.Accounts.Count == 0)
                {
                  <p class="cp-account-group__empty">@text["AccountGroupEmpty"]</p>
                }
              </section>
            }
          }
          <p class="cp-accounts__note"><CpIcon Name="info" Size="15" />@text["AccountsNote"]</p>
        </nav>

        @if (selected is { } shown)
        {
          <div class="cp-accounts__detail">
            <section class="cp-card cp-card--flush">
              <div class="cp-account-head">
                <IconTile Icon="wallet" Colour="var(--cp-primary)" Size="52" Round="true" />
                <div class="cp-account-head__text">
                  <h2 class="cp-h2">@shown.AccountName</h2>
                  <div class="cp-account-head__meta">
                    <span class="cp-account-head__number">@IbanMask.Mask(shown.AccountReference)</span>
                    · @text["AccountsLatestBooking", BookingFormat.Date(shown.LatestBookedOn)]
                  </div>
                </div>
                <div class="cp-account-head__balance">
                  <div class="cp-label">@text["AccountsBalance"]</div>
                  <Sum AmountInCents="shown.BalanceInCents" />
                </div>
              </div>
              <div class="cp-account-tabs">
                <Tabs TValue="AccountView" Options="Views" @bind-Value="view" Label="@text["AccountsTabs"]" />
              </div>
              @if (view == AccountView.Overview && histories.TryGetValue(shown.AccountReference, out var history))
              {
                <AccountBalanceChart History="history" />
              }
              @if (view == AccountView.Bookings && bookings is not null)
              {
                <div role="tabpanel" class="cp-account-bookings">
                  <div class="cp-account-bookings__head">
                    <a class="cp-account-bookings__all" href="@BookingListQuery.LinkFor(new BookingFilter(AccountReference: shown.AccountReference))">
                      @text["AccountsAllBookings"]
                    </a>
                  </div>
                  <BookingDayList Bookings="bookings.Items" OnSelect="Open" />
                </div>
              }
            </section>
            @if (view == AccountView.Overview && flows is not null)
            {
              <div role="tabpanel" class="cp-account-overview">
                <AccountFlowChart Months="flows.Months" />
                <AccountRecentCard Flows="flows" OnSelect="Open" />
              </div>
            }
          </div>
        }
      </div>
    </ChildContent>
  </PageFrame>

  <BookingSheet Booking="opened" OnClose="Close" />
}

@code {
    /// <summary>How many of the account's bookings the page lists; the booking list has the rest.</summary>
    public const int BookingsShown = 30;

    private AccountOverview? overview;
    private IReadOnlyList<AccountGroupSummary> groups = [];
    private int revision;
    private bool editing;
    private bool loaded;

    private AccountBalance? selected;
    private AccountView view = AccountView.Overview;
    private Page<Booking>? bookings;
    private AccountFlows? flows;
    private Dictionary<string, AccountBalanceHistory> histories = [];
    private Booking? opened;

    /// <summary>The reference of the account to show; the highest balance when absent or unknown.</summary>
    [SupplyParameterFromQuery(Name = "account")]
    public string? AccountReference { get; set; }

    protected override async Task OnInitializedAsync()
    {
        overview = await accounts.ReadAsync();

        // Only with accounts to show: a page without them shows no groups,
        // so it has no reason to start one.
        if (overview is not null)
        {
            await ReadGroupsAsync();
            histories = (await historyReader.ReadAsync())
                .ToDictionary(history => history.AccountReference, StringComparer.Ordinal);
        }

        loaded = true;
    }

    // A click on a card changes the address, which sets the parameter again
    // on the page already shown, so the selection follows the URL.
    protected override async Task OnParametersSetAsync()
    {
        if (overview is null)
        {
            return;
        }

        var asked = overview.Accounts.FirstOrDefault(account
            => string.Equals(account.AccountReference, AccountReference, StringComparison.Ordinal))
            ?? overview.Accounts[0];

        if (asked == selected)
        {
            return;
        }

        selected = asked;
        opened = null;
        bookings = await bookingReader.ReadPageAsync(new BookingPageRequest(
            Skip: 0,
            Take: BookingsShown,
            Filter: new BookingFilter(AccountReference: asked.AccountReference)));
        flows = await flowReader.ReadAsync(asked.AccountReference);
    }

    /// <summary>The two views of the selected account the tabs switch between.</summary>
    private enum AccountView
    {
        Overview,
        Bookings,
    }

    // The overview first and selected, as in the design; the bookings tab
    // carries their count, as the heading above the list did.
    private IReadOnlyList<TabOption<AccountView>> Views =>
    [
        new(AccountView.Overview, text["AccountsTabOverview"]),
        new(AccountView.Bookings, text["AccountsBookings"], bookings is null ? null : BookingFormat.Count(bookings.TotalCount)),
    ];

    private async Task ReadGroupsAsync()
    {
        groups = await groupEditor.ReadAsync(text["AccountGroupsStart"]);
        revision++;
    }

    // Read again whatever the outcome: a change the rules refused leaves the
    // groups as stored, and one that found its group gone — deleted in another
    // browser — is best answered with what is there now.
    private async Task ChangeAsync(Func<AccountGrouping, AccountGroupingOutcome> change)
    {
        await groupEditor.ChangeAsync(change);
        await ReadGroupsAsync();
    }

    /// <summary>How many of the latest points of a history the sparkline on a card draws.</summary>
    public const int TrendPoints = 6;

    // The card's sparkline: the last points of a history that holds, or none
    // where there is no line worth drawing.
    private IReadOnlyList<long>? Trend(AccountBalance account)
        => histories.TryGetValue(account.AccountReference, out var history) && history.Holds && history.Points.Count >= 2
            ? [.. history.Points.TakeLast(TrendPoints).Select(point => point.BalanceInCents)]
            : null;

    private static string LinkTo(AccountBalance account)
        => "accounts?account=" + Uri.EscapeDataString(account.AccountReference);

    private void Open(Booking booking) => opened = booking;

    private void Close() => opened = null;

    /// <summary>
    /// The lead, with the total set apart. The sentence comes from the resource
    /// file with the figure as a placeholder, so the markup is put together
    /// here: every piece of text is encoded before it joins the one element added.
    /// </summary>
    private MarkupString Lead(AccountOverview figures)
    {
        var (whole, cents) = OverviewFormat.SumParts(figures.TotalInCents);
        var figure = $"<b class=\"cp-overview__lead-figure\">{WebUtility.HtmlEncode(whole + cents)}</b>";
        var sentence = figures.Accounts.Count == 1
            ? WebUtility.HtmlEncode(text["AccountsLeadOne"].Value)
            : WebUtility.HtmlEncode(text["AccountsLeadMany"].Value);

        return new MarkupString(string.Format(
            CultureInfo.CurrentCulture,
            sentence,
            figure,
            WebUtility.HtmlEncode(BookingFormat.Count(figures.Accounts.Count))));
    }
}
