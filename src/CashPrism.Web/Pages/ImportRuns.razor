@page "/imports"
@using CashPrism.Application.Imports
@using CashPrism.Application.Paging
@using CashPrism.Domain.Imports
@using CashPrism.Web.Imports
@using CashPrism.Web.Localisation
@inject IStringLocalizer<Strings> text
@inject IImportRunReader reader

<PageFrame Title="@text["NavImportRuns"]" Lead="@text["ImportRunsLead"]">
  @if (isEmpty)
  {
    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
      <MudText Typo="Typo.body1">@text["ImportRunsEmpty"]</MudText>
      <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">@text["ImportRunsEmptyHint"]</MudText>
      <MudButton Href="/import"
                 Variant="Variant.Filled"
                 Color="Color.Primary"
                 StartIcon="@Icons.Material.Filled.UploadFile"
                 Class="mt-4">
        @text["NavImport"]
      </MudButton>
    </MudPaper>
  }
  else
  {
    @* Neither sortable nor filterable: this is a history, and a history has one
       order. Sorting it by file name would only make it harder to see what
       happened last. *@
    <MudDataGrid T="ImportRun"
                 ServerData="LoadAsync"
                 Elevation="0"
                 Outlined="true"
                 Dense="true"
                 Hover="true"
                 Filterable="false"
                 SortMode="SortMode.None">
      <Columns>
        <TemplateColumn T="ImportRun" Title="@text["ImportRunsColumnImportedAt"]" CellClass="cp-figure">
          <CellTemplate>@ImportRunFormat.ImportedAt(context.Item.ImportedAt)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ImportRun" Title="@text["ImportRunsColumnFile"]">
          @* An export's file name is whatever it was saved as, so the column is
             clamped and the whole name stays available on hover. *@
          <CellTemplate>
            <span class="cp-reference" title="@context.Item.FileName">@context.Item.FileName</span>
          </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ImportRun" Title="@text["ImportRunsColumnExportedOn"]" CellClass="cp-figure">
          <CellTemplate>
            @(ImportRunFormat.ExportedOn(context.Item.ExportedOn) ?? text["ImportRunsNoExportDate"].Value)
          </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ImportRun" Title="@text["ImportRunsColumnHash"]" CellClass="cp-figure">
          <CellTemplate>
            <span class="cp-mono" title="@context.Item.FileHash">@ImportRunFormat.ShortHash(context.Item.FileHash)</span>
          </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ImportRun" Title="@text["ImportRunsColumnRowsRead"]"
                        HeaderStyle="text-align: end" CellClass="cp-figure cp-cell-end">
          <CellTemplate>@ImportRunFormat.Count(context.Item.RowsRead)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ImportRun" Title="@text["ImportRunsColumnInserted"]"
                        HeaderStyle="text-align: end" CellClass="cp-figure cp-cell-end">
          <CellTemplate>@ImportRunFormat.Count(context.Item.BookingsInserted)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ImportRun" Title="@text["ImportRunsColumnUpdated"]"
                        HeaderStyle="text-align: end" CellClass="cp-figure cp-cell-end">
          <CellTemplate>@ImportRunFormat.Count(context.Item.BookingsUpdated)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ImportRun" Title="@text["ImportRunsColumnUnchanged"]"
                        HeaderStyle="text-align: end" CellClass="cp-figure cp-cell-end">
          <CellTemplate>@ImportRunFormat.Count(context.Item.BookingsUnchanged)</CellTemplate>
        </TemplateColumn>
      </Columns>
      <PagerContent>
        <MudDataGridPager T="ImportRun" PageSizeOptions="PageSizes" InfoFormat="@PagerText" />
      </PagerContent>
    </MudDataGrid>
  }
</PageFrame>

@code {
    /// <summary>
    /// The pages a person can pick, the same set the booking list offers.
    /// MudBlazor's "all" entry is left out for the same reason: it asks for
    /// every run at once.
    /// </summary>
    private static readonly int[] PageSizes = [25, 50, 100];

    private bool isEmpty;

    private int firstOnPage;
    private int lastOnPage;
    private int totalCount;

    /// <summary>The pager's info line — see <see cref="CashPrism.Web.Localisation.PagerInfo"/>.</summary>
    private string PagerText => PagerInfo.Compose(
        text["MudDataGridPager_InfoFormat"],
        firstOnPage,
        lastOnPage,
        totalCount);

    protected override async Task OnInitializedAsync()
        => isEmpty = await reader.CountAsync() == 0;

    private async Task<GridData<ImportRun>> LoadAsync(GridState<ImportRun> state, CancellationToken cancellationToken)
    {
        var request = new PageRequest(
            Skip: state.Page * state.PageSize,
            // Clamped rather than rejected: the page size travels from the
            // browser, and a value the model refuses would take the circuit down
            // instead of showing a list.
            Take: Math.Clamp(state.PageSize, 1, PageRequest.MaxTake));

        var page = await reader.ReadPageAsync(request, cancellationToken);

        totalCount = page.TotalCount;
        firstOnPage = PagerInfo.First(request.Skip, page.Items.Count);
        lastOnPage = PagerInfo.Last(request.Skip, page.Items.Count);

        // The grid renders itself when this returns, not the page around it, so
        // the pager would otherwise keep the info line of the page before.
        await InvokeAsync(StateHasChanged);

        return new GridData<ImportRun> { Items = page.Items, TotalItems = page.TotalCount };
    }
}
