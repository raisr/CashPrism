@inherits LayoutComponentBase
@implements IDisposable
@inject IStringLocalizer<Strings> text
@inject NavigationManager navigation

@* The document title is built here rather than in every page: the navigation
   list already names each destination, so repeating it per page would give the
   same route two labels that can drift apart. *@
<PageTitle>@DocumentTitle</PageTitle>

<MudThemeProvider @ref="themeProvider"
                  Theme="CashPrismTheme.Instance"
                  @bind-IsDarkMode="isDarkMode"
                  ObserveSystemDarkModeChange="@(!themeChosenByUser)" />
<ThemeAttribute IsDarkMode="isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* Collapsing to the icon rail narrows MudBlazor's own drawer width variable on
   the layout, so the drawer, the app bar and the content beside it all follow
   one value. The stylesheet applies it only where the drawer is permanent. *@
<MudLayout Class="@(sidebarCollapsed ? "cp-shell--rail" : null)">
  @* The drawer is not clipped by the app bar, so it runs the full height and
     carries the product name; the app bar beside it names the current page. *@
  <MudAppBar Elevation="0" Color="Color.Surface" Class="cp-topbar">
    @* Only where the drawer folds away: on a wide screen it is always there,
       and a button that hides it would only hide the way around. *@
    <button type="button" class="cp-iconbtn cp-topbar__menu"
            aria-label="@text["NavigationToggle"]"
            @onclick="ToggleDrawer">
      <CpIcon Name="menu" />
    </button>
    @* Small, muted and spaced out: this says where you are, the page's own
       heading says what you are looking at. *@
    <span class="cp-topbar__section">@CurrentTitle</span>
    <span class="cp-topbar__spacer"></span>
    <button type="button" class="cp-iconbtn"
            aria-label="@text["ThemeToggle"]"
            @onclick="ToggleTheme">
      <CpIcon Name="@(isDarkMode ? "sun" : "moon")" />
    </button>
    <MudButton Href="/import" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="cp-btn cp-btn--sm">
      <CpIcon Name="upload" />
      @text["NavImport"]
    </MudButton>
  </MudAppBar>

  @* Responsive at MudBlazor's Md breakpoint (960 px). The design folds the
     drawer at 1040 px, but MudBlazor's breakpoints are fixed, and its drawer
     keeps a narrow screen from flashing the open drawer before the circuit is
     up — which a breakpoint of our own would have to rebuild. *@
  <MudDrawer @bind-Open="drawerOpen"
             Variant="DrawerVariant.Responsive"
             Breakpoint="Breakpoint.Md"
             Elevation="0">
    <Sidebar Collapsed="sidebarCollapsed" OnToggleCollapsed="ToggleSidebar" />
  </MudDrawer>

  @* MudMainContent contributes only the offset that keeps content clear of the
     fixed app bar — no padding of its own. A page frames itself, which leaves
     room for one that wants a second column — a list of accounts beside the
     content — without the layout having to change. *@
  <MudMainContent Class="app-content">
    @Body
  </MudMainContent>
</MudLayout>

@code {
    private bool drawerOpen = true;

    // Lasts for the session; remembering it across a reload is a separate
    // concern (issue #92).
    private bool sidebarCollapsed;

    private bool isDarkMode;
    private bool themeChosenByUser;
    private MudThemeProvider? themeProvider;

    private NavigationItem? Current
        => NavigationItems.Match(navigation.ToBaseRelativePath(navigation.Uri));

    private string CurrentTitle => Current is { } item ? text[item.TitleKey] : string.Empty;

    private string DocumentTitle => Current is { } item ? $"CashPrism — {text[item.TitleKey]}" : "CashPrism";

    protected override void OnInitialized()
        => navigation.LocationChanged += OnLocationChanged;

    // The app bar reads the route, so it has to re-render when the route changes.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => StateHasChanged();

    // ObserveSystemDarkModeChange only reports a change of the system setting,
    // not the setting itself, so the starting value is asked for once. A click
    // on the switch that beat the answer here wins.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || themeProvider is null)
        {
            return;
        }

        var systemIsDark = await themeProvider.GetSystemDarkModeAsync();
        if (!themeChosenByUser && systemIsDark != isDarkMode)
        {
            isDarkMode = systemIsDark;
            StateHasChanged();
        }
    }

    private void ToggleDrawer() => drawerOpen = !drawerOpen;

    private void ToggleSidebar() => sidebarCollapsed = !sidebarCollapsed;

    private void ToggleTheme()
    {
        isDarkMode = !isDarkMode;

        // From here on the person has said which theme they want, so the system
        // preference stops overriding the choice for the rest of the session.
        themeChosenByUser = true;
    }

    public void Dispose()
        => navigation.LocationChanged -= OnLocationChanged;
}
