@* The root component: the whole HTML document is rendered by Blazor. *@
<!DOCTYPE html>
@* The language comes from the culture the host set, so the document never claims
   a language the UI is not written in. *@
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <base href="/" />
  <link rel="stylesheet" href="_content/CashPrism.Web/app.css" />
  <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
  <Routes @rendermode="InteractiveServer" />
  <script src="_framework/blazor.web.js"></script>
</body>

</html>
