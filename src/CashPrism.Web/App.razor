@* The root component: the whole HTML document is rendered by Blazor. *@
<!DOCTYPE html>
@* The language comes from the culture the host set, so the document never claims
   a language the UI is not written in. *@
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <base href="/" />
  @* Both files come out of the MudBlazor package's static web assets and are
     served by this application. MudBlazor's own getting-started page links
     Roboto from fonts.googleapis.com instead; CashPrism does not, because
     everything stays local and the machine may have no internet at all. The
     font stack is set on the theme. *@
  <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
  @* The icon font is bundled for the same reason: Lucide's own setup points at
     a CDN. *@
  <link rel="stylesheet" href="_content/CashPrism.Web/icons/lucide.css" />
  <link rel="stylesheet" href="_content/CashPrism.Web/css/components.css" />
  <link rel="stylesheet" href="_content/CashPrism.Web/app.css" />
  @* The SVG for every browser that takes one, the ICO for the rest. *@
  <link rel="icon" type="image/svg+xml" href="_content/CashPrism.Web/favicon.svg" />
  <link rel="icon" sizes="16x16 32x32 48x48" href="_content/CashPrism.Web/favicon.ico" />
  <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
  <Routes @rendermode="InteractiveServer" />
  <script src="_framework/blazor.web.js"></script>
  <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>
